# ══════════════════════════════════════════════════════════════════
#  Launch Radar & Sniper Bot — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_ENV=development           # development | paper | live
LOG_LEVEL=INFO
OPERATOR_TIMEZONE=UTC

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://radar:changeme@localhost:5432/radar_db
DATABASE_URL_SYNC=postgresql://radar:changeme@localhost:5432/radar_db   # Alembic

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telegram Bot ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated list of authorized operator Telegram user IDs
TELEGRAM_OPERATOR_IDS=123456789,987654321
# Channel/chat ID to receive alerts (use negative ID for groups)
TELEGRAM_ALERT_CHAT_ID=-100123456789

# ── RapidAPI Twitter / X ──────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
RAPIDAPI_POLL_INTERVAL_SECONDS=3.0
RAPIDAPI_SEARCH_QUERIES='"CA soon" OR "contract dropping soon"'
MIN_TWEET_DATE=2026-10-01

# ── X (Twitter) API ───────────────────────────────────────────────
X_BEARER_TOKEN=your_bearer_token_here
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# ── Google Gemini AI Provider ─────────────────────────────────────
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_ENABLED=true
GEMINI_TIMEOUT=30.0
GEMINI_MAX_RETRIES=3
GEMINI_MAX_DAILY_REQUESTS=1000

# ── AI Scoring Weights & Thresholds ───────────────────────────────
AI_MIN_PROJECT_SCORE=80.0
AI_UTILITY_WEIGHT=25.0
AI_CREDIBILITY_WEIGHT=20.0
AI_COMMUNITY_WEIGHT=15.0
AI_X_ACCOUNT_WEIGHT=15.0
AI_LAUNCH_CONFIRMATION_WEIGHT=15.0
AI_ECOSYSTEM_WEIGHT=10.0

# ── Verification & Safety Controls ────────────────────────────────
REQUIRE_MANUAL_PROJECT_APPROVAL=true
REQUIRE_VERIFIED_OFFICIAL_CA=true
ENABLE_LIVE_TRADING=false
CA_EXECUTION_TARGET_MS=2000

# ── Risk Limits (Phase 1 — no live trading yet) ───────────────────
MAX_BUY_TAX_PCT=3.0
MAX_SELL_TAX_PCT=3.0
MIN_QUALIFYING_VOLUME_USD=100.0
PER_TRADE_SPEND_CAP_USD=50.0
DAILY_SPEND_CAP_USD=200.0
DAILY_LOSS_CAP_USD=150.0
MAX_OPEN_POSITIONS=3

# ── Timing Defaults ───────────────────────────────────────────────
# How long (hours) to wait for a CA after announced launch time
CA_DELAY_TIMEOUT_HOURS=4
# Fallback if no launch time announced (hours from CA detection)
CA_DELAY_NO_LAUNCH_TIME_HOURS=24
# How long (hours) a project sits in Pending Approval before expiry
PENDING_APPROVAL_EXPIRY_HOURS=48

