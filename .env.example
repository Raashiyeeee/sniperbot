# ══════════════════════════════════════════════════════════════════
#  Launch Radar & Sniper Bot — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
#
#  Authoritative Elysium Ultra-Fast Sniper doc:
#    config/ELYSIUM_ULTRA_FAST_SNIPER.md
#    config/elysium_sniper.py
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
APP_ENV=development           # development | paper | live
LOG_LEVEL=INFO
OPERATOR_TIMEZONE=UTC

# ── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://radar:changeme@localhost:5432/radar_db
DATABASE_URL_SYNC=postgresql://radar:changeme@localhost:5432/radar_db   # Alembic

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telegram Bot ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated list of authorized operator Telegram user IDs
TELEGRAM_OPERATOR_IDS=123456789,987654321
# Channel/chat ID to receive alerts (use negative ID for groups)
TELEGRAM_ALERT_CHAT_ID=-100123456789

# ── Telegram Userbot (for private/CAPTCHA-protected groups) ───────
# Get API ID & Hash from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generated via: python3 scripts/generate_telegram_session.py
TELEGRAM_SESSION_STRING=
TELEGRAM_USERBOT_CHATS=

# ── RapidAPI Twitter / X ──────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_TWITTER_HOST=twitter-api45.p.rapidapi.com
RAPIDAPI_POLL_INTERVAL_SECONDS=300.0
RAPIDAPI_APPROVED_POLL_INTERVAL_SECONDS=3.0
RAPIDAPI_SEARCH_QUERIES='"CA soon" OR "contract dropping soon"'
MIN_TWEET_DATE=2026-10-01

# ── X (Twitter) API ───────────────────────────────────────────────
X_BEARER_TOKEN=your_bearer_token_here
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_TOKEN_SECRET=your_access_token_secret_here

# ── Google Gemini AI Provider ─────────────────────────────────────
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_ENABLED=true
GEMINI_TIMEOUT=30.0
GEMINI_MAX_RETRIES=3
GEMINI_MAX_DAILY_REQUESTS=1000

# ── AI Scoring Weights & Thresholds ───────────────────────────────
AI_MIN_PROJECT_SCORE=80.0
AI_UTILITY_WEIGHT=25.0
AI_CREDIBILITY_WEIGHT=20.0
AI_COMMUNITY_WEIGHT=15.0
AI_X_ACCOUNT_WEIGHT=15.0
AI_LAUNCH_CONFIRMATION_WEIGHT=15.0
AI_ECOSYSTEM_WEIGHT=10.0

# ── Verification & Safety Controls ────────────────────────────────
REQUIRE_MANUAL_PROJECT_APPROVAL=true
REQUIRE_VERIFIED_OFFICIAL_CA=true
ENABLE_LIVE_TRADING=false
CA_EXECUTION_TARGET_MS=2000
CA_EXECUTION_TARGET_MIN_MS=1000
CA_EXECUTION_TARGET_MAX_MS=5000
DEFAULT_SNIPER_CHAIN_ID=elysium

# ── Monitoring (Ultra-Fast Sniper §2) ─────────────────────────────
X_CA_DETECTION_ENABLED=true
TELEGRAM_CA_DETECTION_ENABLED=true
TELEGRAM_ADMIN_VERIFICATION_REQUIRED=true
IGNORE_NON_ADMIN_TELEGRAM_CA=true
DUPLICATE_CA_DETECTION_ENABLED=true

# ── Shortlist preload (project docs = source of truth) ────────────
SHORTLIST_DIR=config/shortlist
SHORTLIST_PRELOAD_ON_START=true

# ── Wallet (EVM / Elysium chain) ─────────────────────────────────
# Your EVM wallet private key (0x-prefixed). NEVER commit the real value.
# Leave blank to stay in paper/simulation mode (no real money spent).
EVM_PRIVATE_KEY=

# ── Buy config (Ultra-Fast Sniper §3) ─────────────────────────────
ELYSIUM_BUY_AMOUNT_HYPE=0.05
HYPE_USD_PRICE=1.0
MAX_BUY_TAX_PCT=2.0
MAX_SELL_TAX_PCT=2.0
MIN_QUALIFYING_VOLUME_USD=100.0
PER_TRADE_SPEND_CAP_USD=50.0
DAILY_SPEND_CAP_USD=200.0
DAILY_LOSS_CAP_USD=150.0
MAX_OPEN_POSITIONS=3
TRANSACTION_SIMULATION_ENABLED=true
HONEYPOT_CHECK_ENABLED=true
ALLOW_DUPLICATE_PURCHASES=false

# ── Selling (Ultra-Fast Sniper §5) — manual only ──────────────────
AUTOMATIC_TAKE_PROFIT=false
AUTOMATIC_STOP_LOSS=false
TRAILING_STOP=false
AUTOMATIC_SELL=false
MANUAL_SELL_ENABLED=true
EMERGENCY_SELL_MANUAL_ONLY=true

# ── EVM execution / gas (Dynamic Fast) ────────────────────────────
EVM_MAX_SLIPPAGE_PCT=5.0
EVM_MAX_PRICE_IMPACT_PCT=5.0
EVM_GAS_STRATEGY=dynamic_fast
EVM_GAS_TIP_MULTIPLIER=1.5
EVM_MAX_GAS_PRICE_GWEI=500
EVM_TX_DEADLINE_SECONDS=60

# ── Elysium Chain RPCs (HTTP + WS, multi-endpoint) ────────────────
# Mainnet: chain id 99901, native HYPE, explorer https://elysiumexplore.com
ELYSIUM_RPC_URL=https://rpc.elysp.com
ELYSIUM_RPC_FALLBACK_URLS=
ELYSIUM_WS_RPC_URL=
# Testnet: chain id 99801, native HYPE
ELYSIUM_TESTNET_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
DEFAULT_SNIPER_CHAIN_ID=elysium

# ── Timing Defaults ───────────────────────────────────────────────
CA_DELAY_TIMEOUT_HOURS=4
CA_DELAY_NO_LAUNCH_TIME_HOURS=24
PENDING_APPROVAL_EXPIRY_HOURS=48
